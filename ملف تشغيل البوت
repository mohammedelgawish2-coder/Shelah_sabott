require('dotenv').config();
const { Telegraf } = require('telegraf');
const fs = require('fs');
const path = require('path');

// تشغيل البوت
const bot = new Telegraf(process.env.BOT_TOKEN);

// تحميل ملفات الأنظمة
const systemsPath = path.join(__dirname);
const systems = [
    'security.js',   // نظام الحماية
    'ranks.js',      // نظام الرتب
    'target.js',     // نظام التارجت
    'reports.js',    // نظام التقارير
    'adminGroup.js', // نظام قروب الأدمن
    'system.js'      // النظام العام
];

// ربط الملفات بالبوت
systems.forEach(file => {
    const fullPath = path.join(systemsPath, file);
    if (fs.existsSync(fullPath)) {
        require(fullPath)(bot);
        console.log(`✔ تم تحميل: ${file}`);
    } else {
        console.log(`✖ الملف غير موجود: ${file}`);
    }
});

// تشغيل البوت
bot.launch()
    .then(() => console.log("🚀 البوت شغال بنجاح"))
    .catch(err => console.log("❌ خطأ في تشغيل البوت:", err));

// منع توقف البوت عند الأخطاء
process.on('uncaughtException', err => {
    console.log("⚠ خطأ غير متوقع:", err);
});

process.on('unhandledRejection', err => {
    console.log("⚠ وعد مرفوض:", err);
});
